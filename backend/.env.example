# Copie para .env (cp .env.example .env) e ajuste. O arquivo .env NÃO é versionado.

PORT=3000
NODE_ENV=development

# Banco: "mysql" (oficial) ou "memory" (sem banco; dados somem ao reiniciar)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=nassau
DB_PASSWORD=nassau_dev
DB_NAME=nassautickets
DB_ROOT_PASSWORD=root_dev

# Autenticação (em produção JWT_SECRET é obrigatório: use um valor longo e aleatório)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Origem(ns) permitidas pelo CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Regras de funcionamento
APP_TIMEZONE=America/Recife
EXPEDIENTE_INICIO=07:00
EXPEDIENTE_FIM=17:00
# false = ignora o horário do expediente (útil para testar fora do horário)
ENFORCE_EXPEDIENTE=true

# Dados iniciais criados por "npm run seed" (troque as senhas!)
SEED_GESTOR_USUARIO=gestor
SEED_GESTOR_SENHA=Gestor@123
SEED_ATENDENTE_USUARIO=atendente
SEED_ATENDENTE_SENHA=Atendente@123
SEED_GUICHES=4
